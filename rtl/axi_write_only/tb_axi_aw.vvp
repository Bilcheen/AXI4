    %vpi_call/w 3 135 "$display", "ERROR: AWREADY should be 0 after AW handshake" {0 0 0};
    %vpi_call/w 3 136 "$finish" {0 0 0};
T_4.6 ;
    %load/vec4 v000002eab5af18c0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_4.8, 6;
    %vpi_call/w 3 140 "$display", "ERROR: WREADY should be 1 after AW handshake" {0 0 0};
    %vpi_call/w 3 141 "$finish" {0 0 0};
T_4.8 ;
    %vpi_call/w 3 145 "$display", "PASS: AW channel test passed" {0 0 0};
    %vpi_call/w 3 146 "$finish" {0 0 0};
    %end;
    .thread T_4;
